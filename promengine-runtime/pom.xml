<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.thirdexploration</groupId>
        <artifactId>promengine-parent</artifactId>
        <version>3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>promengine-runtime</artifactId>
    <packaging>jar</packaging>

    <name>promengine-runtime</name>
    <description>PromEngine 核心运行时装配模块</description>

    <dependencies>
        <!-- 核心执行器模块（包含 Orchestrator、ToolExecutor 等） -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-executor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 记忆系统模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 模型网关模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 提示词模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-prompt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 认知模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-cognition</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 技能模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-skill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-ecosystem</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-adapter-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 核心接口模块 -->
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.thirdexploration</groupId>
            <artifactId>promengine-neuro</artifactId>
            <version>${project.version}</version>        </dependency>
        <!-- Spring Boot 基础依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

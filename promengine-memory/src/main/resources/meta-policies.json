{
  "version": 1,
  "domains": [
    {"name": "general", "description": "通用记忆域", "default": true},
    {"name": "code", "description": "代码记忆域", "default": false},
    {"name": "legal", "description": "法律文书域", "default": false}
  ],
  "layers": [

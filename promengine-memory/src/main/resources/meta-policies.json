    {"name": "semantic", "description": "语义记忆", "ttl": null, "maxCapacity": 100000, "forgettingRate": 0.05},
    {"name": "procedural", "description": "过程记忆", "ttl": null, "maxCapacity": 10000, "forgettingRate": 0.0,"reliabilityThreshold": 0.7},
    {"name": "collective", "description": "集体记忆", "ttl": null, "maxCapacity": 50000, "forgettingRate": 0.0}
  ],
  "sharingLevels": [
    {"name": "private", "description": "仅创建者"},
